{
  "name": "dsh-skills-center",
  "version": "0.0.1",
  "description": "DSH 技能中心 — skills.sh 全量目录的离线浏览、中文判断与按需激活",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "data",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/oidc": "^4.0.1"
  },
  "scripts": {
    "check": "node --input-type=module -e \"import('./lib/index.js').then(m => console.log('exports:', Object.keys(m).sort().join(', ')))\"",
    "test": "node tests/smoke.mjs && node tests/client.test.mjs && node collector/pipeline.test.mjs && node collector/fetch.test.mjs && node collector/replay.test.mjs && node api/collect.test.mjs",
    "collect": "node collector/run.mjs",
    "collect:replay": "node collector/run.mjs --replay collector/fixtures/v1-sample.json"
  }
}
